# Local development demo only. Do not use for real or sensitive documents.
DEMO_MODE_LOCAL=true
VITE_LOCAL_DEMO_MODE=true
LOCAL_STORAGE_DIR=./local-storage

# XAMPP / MariaDB connection (create the database once in phpMyAdmin).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=document_risk_analyst

# Backend and frontend development ports.
API_PORT=5000
VITE_PORT=3000
BASE_PATH=/

# Optional for non-demo Google Cloud Storage deployments only.
# Use Application Default Credentials; never commit service-account keys.
# GOOGLE_CLOUD_PROJECT=
# PRIVATE_OBJECT_DIR=/your-bucket/private
# PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket/public

# Free local AI with Ollama. Keep this endpoint on loopback; never expose it publicly.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional local PDF signature verifier (Poppler's pdfsig.exe).
# Leave blank to look for pdfsig on PATH.
PDFSIG_PATH=
# Optional NSS certificate database directory used to establish signer trust.
PDFSIG_NSS_DIR=
